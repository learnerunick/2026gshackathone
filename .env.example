# Vercel project environment variables (server-side only; never NEXT_PUBLIC_)
BOCA_PUBLIC_ORIGIN=https://your-project.vercel.app
BOCA_BRIDGE_ORIGIN=https://boca-worker.your-domain.example
# Generate three different random values with: python3 scripts/setup_remote.py
BOCA_BRIDGE_SECRET=replace-with-at-least-32-random-characters
BOCA_SESSION_SECRET=replace-with-a-different-32-character-random-secret
BOCA_DASHBOARD_PASSWORD=replace-with-a-different-32-character-random-password
